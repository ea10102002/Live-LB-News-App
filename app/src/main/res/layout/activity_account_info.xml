<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="2dp"
        android:background="@color/surfaceColor">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAccount"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="My Profile &amp; Settings"
            app:titleTextColor="@color/primaryTextColor" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Brand / Profile Badge -->
            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_livelb_logo"
                android:layout_marginBottom="12dp"
                android:contentDescription="Profile Logo" />

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Details"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primaryTextColor"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor"
                app:cardBackgroundColor="@color/surfaceColor"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="First Name:"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last Name:"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email:"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvBirthDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Birthdate:"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvSavedCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saved Articles (SQLite): 0"
                        android:textColor="@color/primaryColor"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditInfo"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Edit Profile Information"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primaryColor"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestNotification"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🔔 Trigger Breaking Alert (WorkManager)"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/aiAccentText"
                app:backgroundTint="@color/aiAccentBg"
                app:strokeColor="@color/aiAccentText"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminDashboard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🛡️ Admin Dashboard"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/errorColor"
                app:strokeColor="@color/errorColor"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/secondaryTextColor"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
